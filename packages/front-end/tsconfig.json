{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    // Overrides the workspace default of CommonJS. Next patches this in when it builds;
    // setting it here is what lets `npm run typecheck` work on its own.
    "module": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
