{
  "name": "back-end",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start:prod": "cross-env NODE_ENV=production nodemon",
    "start:dev": "cross-env NODE_ENV=development nodemon"
  },
  "dependencies": {
    "express": "^4.21.2",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.15"
  },
  "nodemonConfig": {
    "ignore": [
      "**/node_modules/**"
    ],
    "delay": 1000,
    "watch": [
      "src/**/*.ts"
    ],
    "ext": "ts,js,mjs,json",
    "verbose": false,
    "exec": "ts-node src/app.ts"
  }
}
