{
  "name": "takehome",
  "scripts": {
    "start": "node scripts/run.mjs",
    "build": "npm run build -w front-end",
    "lint": "npm run lint -w front-end",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "ts-node --transpileOnly scripts/seed.ts",
    "seed-prod": "ts-node --transpileOnly scripts/seed.ts --full",
    "bundle": "node scripts/bundle.mjs",
    "prepare-submission": "node scripts/bundle.mjs"
  },
  "workspaces": [
    "packages/front-end",
    "packages/back-end",
    "packages/shared"
  ],
  "devDependencies": {
    "@faker-js/faker": "^7.6.0",
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
